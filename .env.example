# Optional Hugging Face token (rate limits / gated models)
# HF_TOKEN=

# Device for compose eval (cpu default; cuda on GPU hosts)
# FAIRAI_DEVICE=cpu

# Override artifact roots inside Compose (defaults match docker-compose)
# FAIRAI_DATA_DIR=/app/artifacts/datasets
# FAIRAI_MODEL_DIR=/app/artifacts/models
# FAIRAI_RESULTS_DIR=/app/artifacts/results
# FAIRAI_LOG_DIR=/app/artifacts/logs
